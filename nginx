==========================================


server {
    listen 80;
    listen [::]:80;

    server_name bai.kokofibo.it.com;

    root /var/www/bai/public;
    index index.php index.html;

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    access_log /var/log/nginx/bai-access.log;
    error_log /var/log/nginx/bai-error.log;
}


